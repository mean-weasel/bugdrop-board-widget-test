# Public deployment identifiers. Use real preview-only values; never staging or production values.
BUGDROP_BOARD_PREVIEW_WORKER_URL=https://bugdrop-board-preview.example.workers.dev
BUGDROP_BOARD_PREVIEW_TENANT_ID=tenant_preview
BUGDROP_BOARD_PREVIEW_APP_ID=app_preview
BUGDROP_BOARD_PREVIEW_DEMO_BOARD_ID=board_preview_demo # Must differ from CI.
BUGDROP_BOARD_PREVIEW_CI_BOARD_ID=board_preview_ci # Must differ from demo.
BUGDROP_BOARD_PREVIEW_TOKEN_ISSUER=https://bugdrop-board-widget-test.vercel.app
BUGDROP_BOARD_PREVIEW_TOKEN_AUDIENCE=bugdrop-board
BUGDROP_BOARD_PREVIEW_TOKEN_KID=preview-2026-01
BUGDROP_BOARD_VENUE_URL=https://bugdrop-board-widget-test.vercel.app # Exact fixed demo alias.
BUGDROP_BOARD_VENUE_PREVIEW_URL=https://bugdrop-board-widget-test-git-preview.example.vercel.app # Exact fixed CI alias; must differ from demo.
BUGDROP_BOARD_VENUE_CONFIG_VERSION=1

# Vercel supplies VERCEL_GIT_COMMIT_SHA. This is the only secret used by the venue.
BOARD_TOKEN_PRIVATE_JWK=
